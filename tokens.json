{
  "$schema": "https://tr.designtokens.org/format/",
  "description": "Design tokens for moelshrief.wiki — single source of truth for colour, type, spacing, radius, and motion. These values mirror the CSS custom properties in src/index.css and the Tailwind theme in tailwind.config.ts.",

  "color": {
    "accent": {
      "$value": "#0d9488",
      "$type": "color",
      "$description": "Primary accent — teal-600. Used for interactive highlights, underlines, and focus rings."
    },
    "background": {
      "light": { "$value": "#fafaf9", "$type": "color", "$description": "stone-50" },
      "dark": { "$value": "#0c0a09", "$type": "color", "$description": "stone-950" }
    },
    "foreground": {
      "light": { "$value": "#292524", "$type": "color", "$description": "stone-800" },
      "dark": { "$value": "#e7e5e4", "$type": "color", "$description": "stone-200" }
    },
    "primary": {
      "$value": "hsl(172 66% 50%)",
      "$type": "color",
      "$description": "teal-400 equivalent. Main interactive colour."
    },
    "muted": {
      "$value": "hsl(25 6% 80%)",
      "$type": "color",
      "$description": "Subdued text and borders."
    },
    "destructive": {
      "$value": "hsl(0 84% 60%)",
      "$type": "color",
      "$description": "Red — errors and danger states."
    },
    "selection": {
      "light": { "$value": "#ccfbf1", "$type": "color", "$description": "teal-100" },
      "dark": { "$value": "#0d4f47", "$type": "color", "$description": "teal-900" }
    }
  },

  "typography": {
    "fontFamily": {
      "sans": {
        "$value": "\"Inter\", ui-sans-serif, system-ui, sans-serif",
        "$type": "fontFamily",
        "$description": "Primary UI font — variable Inter loaded from Google Fonts."
      },
      "serif": {
        "$value": "\"Lora\", Georgia, serif",
        "$type": "fontFamily",
        "$description": "Section headings and editorial emphasis."
      }
    },
    "fontSize": {
      "xs":   { "$value": "0.75rem",  "$type": "dimension" },
      "sm":   { "$value": "0.875rem", "$type": "dimension" },
      "base": { "$value": "1rem",     "$type": "dimension" },
      "lg":   { "$value": "1.125rem", "$type": "dimension" },
      "xl":   { "$value": "1.25rem",  "$type": "dimension" },
      "2xl":  { "$value": "1.5rem",   "$type": "dimension" },
      "3xl":  { "$value": "1.875rem", "$type": "dimension" },
      "4xl":  { "$value": "2.25rem",  "$type": "dimension" }
    },
    "fontWeight": {
      "light":   { "$value": "300", "$type": "fontWeight", "$description": "Default body weight." },
      "regular": { "$value": "400", "$type": "fontWeight" },
      "medium":  { "$value": "500", "$type": "fontWeight" },
      "semibold":{ "$value": "600", "$type": "fontWeight" },
      "bold":    { "$value": "700", "$type": "fontWeight" }
    },
    "lineHeight": {
      "tight":   { "$value": "1.25", "$type": "number" },
      "snug":    { "$value": "1.375","$type": "number" },
      "normal":  { "$value": "1.5",  "$type": "number" },
      "relaxed": { "$value": "1.625","$type": "number" }
    }
  },

  "spacing": {
    "0":  { "$value": "0px",     "$type": "dimension" },
    "1":  { "$value": "0.25rem", "$type": "dimension" },
    "2":  { "$value": "0.5rem",  "$type": "dimension" },
    "3":  { "$value": "0.75rem", "$type": "dimension" },
    "4":  { "$value": "1rem",    "$type": "dimension" },
    "6":  { "$value": "1.5rem",  "$type": "dimension" },
    "8":  { "$value": "2rem",    "$type": "dimension" },
    "12": { "$value": "3rem",    "$type": "dimension" },
    "16": { "$value": "4rem",    "$type": "dimension" },
    "24": { "$value": "6rem",    "$type": "dimension" }
  },

  "borderRadius": {
    "sm": { "$value": "calc(var(--radius) - 4px)", "$type": "dimension", "$description": "~0.25rem" },
    "md": { "$value": "calc(var(--radius) - 2px)", "$type": "dimension", "$description": "~0.375rem" },
    "lg": { "$value": "var(--radius)",             "$type": "dimension", "$description": "0.5rem (default)" },
    "full": { "$value": "9999px", "$type": "dimension" }
  },

  "motion": {
    "duration": {
      "fast":   { "$value": "150ms", "$type": "duration" },
      "normal": { "$value": "200ms", "$type": "duration" },
      "slow":   { "$value": "300ms", "$type": "duration" }
    },
    "easing": {
      "standard": {
        "$value": "cubic-bezier(0.4, 0, 0.2, 1)",
        "$type": "cubicBezier",
        "$description": "Material Design standard easing — used for most transitions."
      },
      "decelerate": {
        "$value": "cubic-bezier(0, 0, 0.2, 1)",
        "$type": "cubicBezier",
        "$description": "Elements entering the screen."
      },
      "accelerate": {
        "$value": "cubic-bezier(0.4, 0, 1, 1)",
        "$type": "cubicBezier",
        "$description": "Elements leaving the screen."
      }
    }
  },

  "breakpoint": {
    "sm":  { "$value": "640px",  "$type": "dimension" },
    "md":  { "$value": "768px",  "$type": "dimension" },
    "lg":  { "$value": "1024px", "$type": "dimension" },
    "xl":  { "$value": "1280px", "$type": "dimension" },
    "2xl": { "$value": "1400px", "$type": "dimension", "$description": "Container max-width breakpoint." }
  }
}
